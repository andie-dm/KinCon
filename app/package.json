{
  "name": "cnh-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Fowpy conference discovery UI and local demo",
  "main": "server.js",
  "scripts": {
    "start": "node --require ./instrumentation.js server.js",
    "dev": "vite --host 127.0.0.1",
